# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/termyte
DATABASE_POOL_MAX=20

# Application
PORT=3000
PUBLIC_APP_URL=http://localhost:3000
AGENT_TOKEN_PEPPER=replace-with-a-random-secret-at-least-32-characters

# Supabase Auth only. Termyte data remains in PostgreSQL above.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Required when connectors are enabled. Generate exactly 32 random bytes and
# encode them as base64. Keep the same value across API and worker services.
# CONNECTOR_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Optional: memory extraction through OpenRouter.
# Leave these variables unset when extraction is disabled.
# OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=10000
EXTRACTION_VERSION=gemma-4-27b-v1

# Optional: GitHub connector.
# GITHUB_APP_SLUG=your-github-app-slug
# GITHUB_WEBHOOK_SECRET=replace-with-at-least-16-random-characters

# Optional: Slack connector.
# SLACK_CLIENT_ID=your-slack-client-id
# SLACK_CLIENT_SECRET=your-slack-client-secret
# SLACK_SIGNING_SECRET=replace-with-at-least-16-random-characters

# Optional: Linear connector. Configure the OAuth app for read-only access and
# send Issue and Comment webhooks to /webhooks/linear.
# LINEAR_CLIENT_ID=your-linear-client-id
# LINEAR_CLIENT_SECRET=your-linear-client-secret
# LINEAR_WEBHOOK_SECRET=replace-with-at-least-16-random-characters

# Optional local demo mode. Do not set this when using Supabase Auth.
# DEMO_USER_ID=00000000-0000-4000-8000-000000000000
